# ---------- Lead delivery (configure at least one) ----------
# Email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
LEAD_TO_EMAIL=info@precisionspares.co.za
LEAD_FROM_EMAIL="Precision Spares <quotes@precisionspares.co.za>"

# Or push every lead to a webhook (Zapier, Make, n8n, HubSpot, Google Sheets, Slack...)
LEAD_WEBHOOK_URL=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://precisionspares.co.za
