# ---------- Lead delivery (configure at least one) ----------
# Send quote requests to the invoicing system's Leads inbox.
# Existing multi-company invoicing deployment; base origin only (no /api path).
# Create a company-scoped key for Precision Spares with leads:write permission.
# These are server-only secrets. Never use a NEXT_PUBLIC_ prefix.
LEDGER_API_URL=https://billing.cretekgroup.co.za
LEDGER_API_KEY=
LEDGER_SITE_ID=precision-spares

# Email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
LEAD_TO_EMAIL=info@precisionspares.co.za
LEAD_FROM_EMAIL="Precision Spares <quotes@precisionspares.co.za>"

# Or push every lead to a webhook (Zapier, Make, n8n, HubSpot, Google Sheets, Slack...)
LEAD_WEBHOOK_URL=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://precisionspares.co.za
NEXT_PUBLIC_CONTACT_EMAIL=info@precisionspares.co.za

# ---------- Analytics and ads (all optional) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
